# MyBlog 后端环境变量示例（复制为 .env 后修改）
# 服务端口
PORT=3000

# JWT 密钥（生产环境务必更换）
JWT_SECRET=myblog-dev-secret

# PostgreSQL（生产接入；当前实现为内存存储网关）
# DATABASE_URL=postgres://user:pass@localhost:5432/myblog

# 对象存储 OSS（生产；当前图片上传保存到本地 uploads/ 目录）
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
